# Server
PORT=4000

# Pathao API (existing)
GEMINI_API_KEY="your_gemini_api_key"
APP_URL="http://localhost:3000"

# Issue System (currently uses local file storage)
# For S3-compatible storage (optional), set these:
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_REGION="us-east-1"
# S3_BUCKET="pathao-issue-attachments"
# S3_ACCESS_KEY="your_access_key"
# S3_SECRET_KEY="your_secret_key"

# Database (currently SQLite; for PostgreSQL in production):
# DATABASE_URL="postgresql://user:password@localhost:5432/pathao_issues"

# Authentication
# For email-based auth:
# AUTH_SECRET="your_auth_secret"

# Notification (Email)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your_email@pathao.com"
# SMTP_PASS="your_app_password"
# NOTIFICATION_FROM="issues@pathao.com"
